DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=balance
DB_USER=balance
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Balance <no-reply@localhost>
